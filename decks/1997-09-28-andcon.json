 "partial": true,
 "notes": [
  {
   "text": "The Duelist #18 (Aug 1997) lists AndCon 97, September 25-28, with the 'Classic (Type I) and Classic-Restricted (Type 1.5) North American Championships'. The day of the Type I event is not known: the date here is the last day of the convention and is not verified. Paguirigan says he went 5-0-1 'for the day', so it was probably a one-day event.",
   "url": "https://archive.org/details/the-duelist-18"
  },
  {
   "text": "The Dojo page heads the deck 'Sep '97' but captions it 'TI Championship, Nov '97'.",
   "url": "https://www.classicdojo.org/history/frenchie.html"
  },
  {
   "text": "Only the winner is known. Paguirigan names opponents Dennis Bentley, Rudy Edwards (a draw) and Eric Taylor but not their finishes. No Top 8, finalist, attendance or other lists were found.",
   "url": "https://www.classicdojo.org/history/frenchie.html"
  }
 ],
